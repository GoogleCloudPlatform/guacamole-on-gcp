-- Create an Administrative Guacamole User idempotently for your Google IAP identity.
-- Modify the SET @username line below if you wish to grant admin access to a different email.

-- Admin user email identity (normalized to lowercase to match IAP extension output)
SET @username = '${admin_email}';

-- Generate salt and random password (unused when logging in via IAP, but required by schema)
SET @salt = UNHEX(SHA2(UUID(), 256));
SET @password = UNHEX(SHA2(UUID(), 256));

START TRANSACTION;

-- Insert the user entity if it does not already exist
INSERT IGNORE INTO guacamole_entity (name, type)
    VALUES (@username, 'USER');

-- Look up the entity_id for the user entity
SET @entity = (SELECT entity_id FROM guacamole_entity WHERE name = @username AND type = 'USER' LIMIT 1);

-- Insert the guacamole_user record if it does not already exist
INSERT IGNORE INTO guacamole_user (entity_id, password_salt, password_hash, password_date)
    VALUES (@entity, @salt, UNHEX(SHA2(CONCAT(HEX(@password), HEX(@salt)), 256)), CURRENT_DATE());

-- Grant ADMINISTER and AUDIT system permissions idempotently
INSERT IGNORE INTO guacamole_system_permission (entity_id, permission)
    VALUES
        (@entity, 'ADMINISTER'),
        (@entity, 'AUDIT');

COMMIT;
