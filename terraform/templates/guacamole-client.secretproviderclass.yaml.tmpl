# SecretProviderClass mounting the Cloud SQL MySQL password and admin bootstrap SQL
# from Google Secret Manager via the GKE Secret Manager CSI add-on (secrets-store-gke.csi.k8s.io).
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: guacamole-secrets
  namespace: guacamole
spec:
  provider: gke
  parameters:
    secrets: |
      - resourceName: "projects/${project_id}/secrets/${mysql_password_secret_id}/versions/latest"
        path: "mysql-password"
      - resourceName: "projects/${project_id}/secrets/${db_init_sql_secret_id}/versions/latest"
        path: "insert-admin-user.sql"
